# ============================================================
# Sistema S2 — variáveis para deploy em VPS (docker compose).
# Copie para .env (no mesmo diretório do docker-compose.yml) e preencha.
# NUNCA versione o .env real.
# ============================================================

# ── Banco de dados (usado pelo container MySQL e montado no DATABASE_URL) ──
# OBRIGATÓRIO preencher — vazio, o container do MySQL nem sobe.
# Gere com:  openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=sistema_s2
MYSQL_USER=s2user
MYSQL_PASSWORD=

# ── Segredos da aplicação (obrigatórios) ──
# Gere cada um com:  openssl rand -base64 48
JWT_SECRET=
ENCRYPTION_KEY=

# ── Administrador inicial (criado no primeiro boot) ──
# OBRIGATÓRIO preencher com uma senha forte e única.
ADMIN_EMAIL=adm@vetmg.com.br
ADMIN_PASSWORD=

# ── Domínio (opcional) ──
DOMAIN=

# ── Inteligência artificial (opcional, mas recomendado) ──
# auto | anthropic | groq
AI_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Recebimento de cotações por e-mail (IMAP) ──
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=adm@vetmg.com.br
IMAP_PASSWORD=
IMAP_TLS=true
IMAP_MAILBOX=INBOX

# ── Envio de e-mail para responder cotações (SMTP) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=adm@vetmg.com.br
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=adm@vetmg.com.br

# ── Agendamento (opcional; padrões já ligados) ──
EMAIL_SYNC_ENABLED=true
EMAIL_SYNC_CRON=*/15 * * * *
ALERTS_ENABLED=true
ALERTS_CRON=0 8 * * *
PORTAL_OPPORTUNITY_SYNC_ENABLED=true
PORTAL_OPPORTUNITY_SYNC_CRON=0 7,12,17 * * *
SCRAPER_SCHEDULE_ENABLED=true
SCRAPER_SCHEDULE_CRON=* * * * *
BACKUP_ENABLED=true
BACKUP_CRON=0 3 * * *
BACKUP_KEEP_DAYS=14

# ── WhatsApp para alertas diários (opcional) ──
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_URL=
WHATSAPP_TO=

# ── Puppeteer (automação de portais; a imagem Docker já instala o chromium) ──
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ── Uploads locais (logos etc.); persistido pelo volume uploads_data ──
UPLOAD_DIR=/app/uploads

# ── Segurança adicional ──
FORCE_SECURE_COOKIES=false
FAILURE_ALERTS_ENABLED=true
