# ============================================================
# Sistema S2 — variáveis para deploy em VPS (docker compose).
# Copie para .env (no mesmo diretório do docker-compose.yml) e preencha.
# NUNCA versione o .env real.
# ============================================================

# ── Banco de dados (usado pelo container MySQL e montado no DATABASE_URL) ──
# OBRIGATÓRIO preencher — vazio, o container do MySQL nem sobe.
# Gere com: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=sistema_s2
MYSQL_USER=s2user
MYSQL_PASSWORD=

# ── Segredos da aplicação (obrigatórios) ──
# Gere cada um com: openssl rand -base64 48
JWT_SECRET=
ENCRYPTION_KEY=

# ── Administrador inicial (criado no primeiro boot) ──
# OBRIGATÓRIO preencher com um login administrativo e senha forte e única.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Domínio e certificado (opcionais, recomendados em produção) ──
# O workflow de deploy persiste DOMAIN na VPS. CERTBOT_EMAIL é usado apenas
# quando o servidor já possui Nginx e o certificado é emitido via certbot.
DOMAIN=
CERTBOT_EMAIL=

# ── Inteligência artificial (opcional) ──
# auto | anthropic | groq
AI_PROVIDER=auto
# Groq: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Recebimento de cotações por e-mail (IMAP) ──
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true
IMAP_MAILBOX=INBOX

# ── Envio de e-mail para responder cotações (SMTP) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=

# ── Agendamento (opcional; padrões já ligados) ──
EMAIL_SYNC_ENABLED=true
EMAIL_SYNC_CRON=*/15 * * * *
ALERTS_ENABLED=true
ALERTS_CRON=0 8 * * *

# ── WhatsApp para alertas diários (opcional) ──
# Opção A — API Cloud da Meta (WhatsApp Business):
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Opção B — webhook próprio; recebe POST {to, message}:
WHATSAPP_WEBHOOK_URL=
# Destino(s) em E.164, separados por vírgula:
WHATSAPP_TO=

# ── Puppeteer (automação de portais; a imagem Docker já instala o Chromium) ──
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ── Uploads locais; persistidos pelo volume uploads_data ──
UPLOAD_DIR=/app/uploads

# ── Integração opcional Compras MG (Prodemge) — reservado ──
PRODEMGE_API_KEY=

# ── Segurança adicional ──
# Ative somente após HTTPS válido no domínio.
FORCE_SECURE_COOKIES=false
# Alertas de falha de jobs por notificação/WhatsApp.
FAILURE_ALERTS_ENABLED=true
