# ============================================================
# Sistema S2 — variáveis para deploy em VPS (docker compose).
# Copie para .env (no mesmo diretório do docker-compose.yml) e preencha.
# NUNCA versione o .env real.
# ============================================================

# ── Banco de dados (usado pelo container MySQL e montado no DATABASE_URL) ──
MYSQL_ROOT_PASSWORD=troque-esta-senha-root-forte
MYSQL_DATABASE=sistema_s2
MYSQL_USER=s2user
MYSQL_PASSWORD=troque-esta-senha-do-app-forte

# ── Segredos da aplicação (obrigatórios) ──
# Gere cada um com:  openssl rand -base64 48
JWT_SECRET=
ENCRYPTION_KEY=

# ── Administrador inicial (criado no primeiro boot) ──
ADMIN_EMAIL=adm@vetmg.com.br
ADMIN_PASSWORD=troque-por-uma-senha-forte

# ── Inteligência artificial (opcional, mas recomendado) ──
# auto | anthropic | groq
AI_PROVIDER=auto
# Groq é gratuito: crie a chave em https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Anthropic (mais preciso): https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Recebimento de cotações por e-mail (IMAP) ──
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=adm@vetmg.com.br
IMAP_PASSWORD=
IMAP_TLS=true
IMAP_MAILBOX=INBOX

# ── Envio de e-mail para responder cotações (SMTP) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=adm@vetmg.com.br
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=adm@vetmg.com.br

# ── Agendamento (opcional; padrões já ligados) ──
EMAIL_SYNC_ENABLED=true
EMAIL_SYNC_CRON=*/15 * * * *
ALERTS_ENABLED=true
ALERTS_CRON=0 8 * * *

# ── WhatsApp para alertas diários (opcional) ──
# Opção A — API Cloud da Meta (WhatsApp Business):
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Opção B — webhook próprio (Z-API/Twilio/n8n); recebe POST {to, message}:
WHATSAPP_WEBHOOK_URL=
# Destino(s) em E.164, separados por vírgula (ex.: 5531999998888):
WHATSAPP_TO=

# ── Puppeteer (automação de portais; a imagem Docker já instala o chromium) ──
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ── Uploads locais (logos etc.); persistido pelo volume uploads_data ──
UPLOAD_DIR=/app/uploads

# ── Integração opcional Compras MG (Prodemge) — reservado, ainda não usado ──
PRODEMGE_API_KEY=
