# ============================================================
# Sistema S2 — variáveis para deploy em VPS (docker compose).
# Copie para .env (no mesmo diretório do docker-compose.yml) e preencha.
# NUNCA versione o .env real.
# ============================================================

# ── Banco de dados ───────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=sistema_s2
MYSQL_USER=s2user
MYSQL_PASSWORD=

# ── Segredos da aplicação (obrigatórios) ────────────────────
# Gere cada um com: openssl rand -base64 48
JWT_SECRET=
ENCRYPTION_KEY=

# ── Administrador inicial ────────────────────────────────────
ADMIN_EMAIL=adm@vetmg.com.br
ADMIN_PASSWORD=

# ── Domínio ──────────────────────────────────────────────────
DOMAIN=

# ── Inteligência artificial ──────────────────────────────────
AI_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Precificação padrão de contingência ─────────────────────
# Esses valores só são usados quando o fluxo não fornece tributo/frete específico.
# Ajuste-os conforme a política comercial/contábil da empresa.
PRICING_DEFAULT_TAX_PERCENT=0
PRICING_DEFAULT_FREIGHT_UNIT=0
# Custo histórico sem data exige confirmação humana para automação.
PRICE_UNDATED_REQUIRES_CONFIRMATION=true

# Auto-match nominal não deve decidir sozinho itens técnicos.
# 1.00 impede auto-confirmação por nome salvo identidade textual total; códigos
# determinísticos continuam utilizáveis. A validação técnica deve prevalecer.
QUOTATION_AUTO_CONFIRM_THRESHOLD=1
QUOTATION_NAME_MATCH_THRESHOLD=0.68
# Geração automática pode ser mantida, mas envio automático permanece desligado.
QUOTATION_AUTO_PIPELINE_ENABLED=true
QUOTATION_AUTO_SEND_ENABLED=false

# ── Recebimento de cotações por e-mail (IMAP) ───────────────
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=adm@vetmg.com.br
IMAP_PASSWORD=
IMAP_TLS=true
IMAP_MAILBOX=INBOX

# ── Envio operacional de propostas/respostas (SMTP) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=adm@vetmg.com.br
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=adm@vetmg.com.br

# ── Agendamento ──────────────────────────────────────────────
EMAIL_SYNC_ENABLED=true
EMAIL_SYNC_CRON="*/15 * * * *"
ALERTS_ENABLED=true
ALERTS_CRON="0 8 * * *"
# Relatório por e-mail removido da operação normal.
DAILY_REPORT_ENABLED=false
PORTAL_OPPORTUNITY_SYNC_ENABLED=true
REMATCH_ENABLED=true
SCRAPER_SCHEDULE_ENABLED=true
PORTAL_LOGIN_SMOKETEST_ENABLED=true
BACKUP_ENABLED=true

# ── Backup ───────────────────────────────────────────────────
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=30
# Cópia externa opcional. O comando recebe BACKUP_FILE com o arquivo recém-gerado.
# Ex.: rclone copy "$BACKUP_FILE" remote:s2licit-backups/
BACKUP_OFFSITE_COMMAND=

# ── WhatsApp para alertas ────────────────────────────────────
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_URL=
WHATSAPP_TO=

# ── Puppeteer ────────────────────────────────────────────────
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Variações de preço acima desses limites vão para revisão humana.
SCRAPER_MAX_PRICE_DROP_PERCENT=70
SCRAPER_MAX_PRICE_RISE_PERCENT=300

# ── Uploads ──────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads

# ── Integração Compras MG ────────────────────────────────────
PRODEMGE_API_KEY=

# ── Segurança ────────────────────────────────────────────────
# Em NODE_ENV=production o cookie já é Secure obrigatoriamente. Esta flag serve
# para forçar Secure também em ambientes não-production que estejam sob TLS.
FORCE_SECURE_COOKIES=false
FAILURE_ALERTS_ENABLED=true

# Migrações aplicadas são imutáveis. Drift interrompe o boot.
MIGRATION_STRICT=true
# DDL de boot deve ser removido progressivamente; produção deve usar migrations.
SCHEMA_BOOT_DDL_ENABLED=false
