# ============================================================
# Sistema S2 — Variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env.
# ============================================================

# Banco de dados MySQL (obrigatório)
# Ex.: mysql://usuario:senha@localhost:3306/s2licit
DATABASE_URL=

# Segredo para assinar os cookies de sessão (JWT).
# Obrigatório em produção. Gere com: openssl rand -base64 48
JWT_SECRET=

# Chave para criptografar credenciais de fornecedores (scrapers).
# Obrigatório em produção. Gere com: openssl rand -base64 48
ENCRYPTION_KEY=

# Porta do servidor (padrão 3000)
PORT=3000

# ------------------------------------------------------------
# Autenticação
# ------------------------------------------------------------
# Modo padrão: login local (email/senha). Para criar o primeiro
# administrador, defina no primeiro boot:
ADMIN_EMAIL=
ADMIN_PASSWORD=

# (Opcional/legado) OAuth externo — deixe vazio para usar login local
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# ------------------------------------------------------------
# Inteligência artificial (enriquecimento, matching assistido)
# ------------------------------------------------------------
# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Modelo a usar (padrão: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# ------------------------------------------------------------
# Integrações externas (opcionais)
# ------------------------------------------------------------
# Chave da API de Compras/Transparência da Prodemge (Compras MG)
# Solicite em: api@prodemge.gov.br
PRODEMGE_API_KEY=

# ------------------------------------------------------------
# Ingestão de cotações por e-mail (IMAP)
# Sem estas variáveis, a tela "Cotações Recebidas" funciona, mas a
# sincronização automática fica desabilitada.
# ------------------------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true
IMAP_MAILBOX=INBOX
