# ============================================================
# Sistema S2 — Variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env.
# ============================================================

# Banco de dados MySQL (obrigatório)
# Ex.: mysql://usuario:senha@localhost:3306/s2licit
DATABASE_URL=

# Segredo para assinar os cookies de sessão (JWT).
# Obrigatório em produção. Gere com: openssl rand -base64 48
JWT_SECRET=

# Chave para criptografar credenciais de fornecedores (scrapers).
# Obrigatório em produção. Gere com: openssl rand -base64 48
ENCRYPTION_KEY=

PORT=3000

# ------------------------------------------------------------
# Autenticação
# ------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# ------------------------------------------------------------
# Inteligência artificial
# ------------------------------------------------------------
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
USD_BRL_RATE=
# Timeout máximo por chamada ao provedor de IA.
LLM_TIMEOUT_MS=90000

# ------------------------------------------------------------
# Integrações externas
# ------------------------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true
IMAP_MAILBOX=INBOX

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=

# ------------------------------------------------------------
# Captura de catálogo dos fornecedores
# ------------------------------------------------------------
SCRAPER_MAX_PAGES=1000
SCRAPER_SCHEDULE_ENABLED=true
SCRAPER_SCHEDULE_CRON=* * * * *

# ------------------------------------------------------------
# Armazenamento
# ------------------------------------------------------------
UPLOAD_DIR=
FIEMG_LICITACOES_URL=

# ------------------------------------------------------------
# Operação
# ------------------------------------------------------------
LOG_LEVEL=info
APP_MEM_LIMIT=
MYSQL_MEM_LIMIT=

# ------------------------------------------------------------
# Jobs agendados
# ------------------------------------------------------------
EMAIL_SYNC_ENABLED=true
EMAIL_SYNC_CRON=*/15 * * * *
ALERTS_ENABLED=true
ALERTS_CRON=0 8 * * *
BACKUP_ENABLED=true
BACKUP_CRON=0 3 * * *
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14

# ------------------------------------------------------------
# Orquestrador canônico de oportunidades
# ------------------------------------------------------------
CANONICAL_RECONCILE_ENABLED=true
CANONICAL_RECONCILE_INTERVAL_MINUTES=5

# ------------------------------------------------------------
# OCR local de documentos
# ------------------------------------------------------------
# Limite de arquivo é verificado ANTES da decodificação base64.
DOCUMENT_MAX_FILE_MB=25
# PDFs sem camada textual usam Poppler + Tesseract localmente.
DOCUMENT_OCR_ENABLED=true
# Teto de páginas submetidas a OCR por documento.
DOCUMENT_OCR_MAX_PAGES=80
# Resolução de rasterização: 120–300 DPI.
DOCUMENT_OCR_DPI=180
# Orçamento total por documento, incluindo rasterização e Tesseract.
DOCUMENT_OCR_TIMEOUT_MS=180000
# Concorrência por processo. Manter 1 em VPS pequena; teto interno = 2.
DOCUMENT_OCR_CONCURRENCY=1

# WhatsApp para alertas
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_URL=
WHATSAPP_TO=

# ------------------------------------------------------------
# Segurança adicional
# ------------------------------------------------------------
FORCE_SECURE_COOKIES=false
FAILURE_ALERTS_ENABLED=true

# ------------------------------------------------------------
# Dados da empresa nos PDFs de proposta
# ------------------------------------------------------------
COMPANY_NAME=
COMPANY_CNPJ=
COMPANY_ADDRESS=
COMPANY_CITY=
COMPANY_STATE=
COMPANY_ZIP=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_BANK_NAME=
COMPANY_BANK_AGENCY=
COMPANY_BANK_ACCOUNT=
COMPANY_LOGO_URL=

# ------------------------------------------------------------
# Proxy de armazenamento/IA legado (Forge)
# ------------------------------------------------------------
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
