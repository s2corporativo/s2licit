# ============================================================
# Sistema S2 — Variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env.
# ============================================================

# Banco de dados MySQL (obrigatório)
# Ex.: mysql://usuario:senha@localhost:3306/s2licit
DATABASE_URL=

# Segredo para assinar os cookies de sessão (JWT).
# Obrigatório em produção. Gere com: openssl rand -base64 48
JWT_SECRET=

# Chave para criptografar credenciais de fornecedores (scrapers).
# Obrigatório em produção. Gere com: openssl rand -base64 48
ENCRYPTION_KEY=

# Porta do servidor (padrão 3000)
PORT=3000

# ------------------------------------------------------------
# Autenticação
# ------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# ------------------------------------------------------------
# Inteligência artificial (enriquecimento, matching assistido)
# ------------------------------------------------------------
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
USD_BRL_RATE=

# ------------------------------------------------------------
# Integrações externas (opcionais)
# ------------------------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true
IMAP_MAILBOX=INBOX

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=

# ------------------------------------------------------------
# Captura de catálogo dos fornecedores (scraper)
# ------------------------------------------------------------
SCRAPER_MAX_PAGES=1000
SCRAPER_SCHEDULE_ENABLED=true
SCRAPER_SCHEDULE_CRON=* * * * *

# ------------------------------------------------------------
# Armazenamento e diversos (opcionais)
# ------------------------------------------------------------
UPLOAD_DIR=
FIEMG_LICITACOES_URL=
LLM_TIMEOUT_MS=

# ------------------------------------------------------------
# Operação
# ------------------------------------------------------------
LOG_LEVEL=
APP_MEM_LIMIT=
MYSQL_MEM_LIMIT=

# ------------------------------------------------------------
# Jobs agendados
# ------------------------------------------------------------
EMAIL_SYNC_ENABLED=true
EMAIL_SYNC_CRON=*/15 * * * *
ALERTS_ENABLED=true
ALERTS_CRON=0 8 * * *
BACKUP_ENABLED=true
BACKUP_CRON=0 3 * * *
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14

# ------------------------------------------------------------
# Orquestrador canônico de oportunidades
# ------------------------------------------------------------
# Mantém os estados de oportunidade, proposta, pedido, entrega e faturamento
# reconciliados dentro da própria aplicação — não depende do GitHub.
CANONICAL_RECONCILE_ENABLED=true
CANONICAL_RECONCILE_INTERVAL_MINUTES=5

# ------------------------------------------------------------
# OCR local de documentos
# ------------------------------------------------------------
# PDFs sem camada de texto são convertidos localmente por Poppler e lidos por
# Tesseract (pt+eng). Os binários já são instalados no Dockerfile.
DOCUMENT_OCR_ENABLED=true
DOCUMENT_OCR_MAX_PAGES=80
DOCUMENT_OCR_DPI=180

# WhatsApp para alertas (opcional)
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_URL=
WHATSAPP_TO=

# ------------------------------------------------------------
# Segurança adicional
# ------------------------------------------------------------
FORCE_SECURE_COOKIES=false
FAILURE_ALERTS_ENABLED=true

# ------------------------------------------------------------
# Dados da empresa nos PDFs de proposta
# ------------------------------------------------------------
COMPANY_NAME=
COMPANY_CNPJ=
COMPANY_ADDRESS=
COMPANY_CITY=
COMPANY_STATE=
COMPANY_ZIP=
COMPANY_PHONE=
COMPANY_EMAIL=

# ------------------------------------------------------------
# Proxy de armazenamento/IA legado (Forge)
# ------------------------------------------------------------
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
