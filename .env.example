# ============================================================
# Sistema S2 — Variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env.
# ============================================================

# Banco de dados MySQL (obrigatório)
# Ex.: mysql://usuario:senha@localhost:3306/s2licit
DATABASE_URL=

# Segredo para assinar os cookies de sessão (JWT).
# Obrigatório em produção. Gere com: openssl rand -base64 48
JWT_SECRET=

# Chave para criptografar credenciais de fornecedores (scrapers).
# Obrigatório em produção. Gere com: openssl rand -base64 48
ENCRYPTION_KEY=

# Porta do servidor (padrão 3000)
PORT=3000

# ------------------------------------------------------------
# Autenticação
# ------------------------------------------------------------
# Modo padrão: login local (email/senha). Para criar o primeiro
# administrador, defina no primeiro boot:
ADMIN_EMAIL=
ADMIN_PASSWORD=

# (Opcional/legado) OAuth externo — deixe vazio para usar login local
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# ------------------------------------------------------------
# Inteligência artificial (enriquecimento, matching assistido)
# ------------------------------------------------------------
# Provedor de IA preferido: auto | anthropic | groq  (padrão: auto)
AI_PROVIDER=auto
# Chave da API da Anthropic (https://console.anthropic.com) — mais precisa
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Chave da GroqCloud (https://console.groq.com) — rápida, tier gratuito
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Cotação USD→BRL usada só para EXIBIR o custo estimado de IA em reais na
# Central de IA (padrão: 5.5). Ajuste quando quiser um número mais fiel.
USD_BRL_RATE=

# ------------------------------------------------------------
# Integrações externas (opcionais)
# ------------------------------------------------------------
# Ingestão de cotações por e-mail (IMAP)
# Sem estas variáveis, a tela "Cotações Recebidas" funciona, mas a
# sincronização automática fica desabilitada.
# ------------------------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true
IMAP_MAILBOX=INBOX

# ------------------------------------------------------------
# Envio de e-mail (SMTP) — para responder cotações com o PDF anexado.
# Sem estas variáveis, o botão "Responder por e-mail" fica oculto.
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=

# ------------------------------------------------------------
# Captura de catálogo dos fornecedores / Capture Core
# ------------------------------------------------------------
# Teto de páginas por categoria na varredura (trava contra paginação infinita).
SCRAPER_MAX_PAGES=1000
# Execução automática no horário configurado por fornecedor.
SCRAPER_SCHEDULE_ENABLED=true
SCRAPER_SCHEDULE_CRON=* * * * *

# Worker persistente de captura (fila/lock/heartbeat ficam no MySQL).
CAPTURE_WORKERS=2
CAPTURE_JOB_POLL_MS=5000
CAPTURE_HEARTBEAT_MS=30000
CAPTURE_RECOVERY_MS=300000
CAPTURE_STALE_MINUTES=15

# Atualização incremental: máximo de ofertas antigas/termos por ciclo.
CAPTURE_REFRESH_LIMIT=250
# Tambasa: teto da descoberta de categorias no full scan.
TAMBASA_MAX_CATEGORIES=1500

# Matching conservador. Valores são frações (0..1).
CAPTURE_AUTO_NAME_MATCH=0.94
CAPTURE_AI_NAME_MATCH_MIN=0.82
# Variação absoluta de preço: >= 60% vai para revisão; >= 300% bloqueia.
CAPTURE_REVIEW_PRICE_CHANGE=0.60
CAPTURE_BLOCK_PRICE_CHANGE=3.00
# Full scan: abaixo de 50% do baseline entra em quarentena; abaixo de 75% alerta.
CAPTURE_FULL_MIN_COVERAGE=0.50
CAPTURE_FULL_WARN_COVERAGE=0.75
# false = observações idênticas não ocupam histórico; alterações/revisões sempre ficam.
CAPTURE_STORE_UNCHANGED=false

# ------------------------------------------------------------
# Armazenamento e diversos (opcionais)
# ------------------------------------------------------------
UPLOAD_DIR=
FIEMG_LICITACOES_URL=
LLM_TIMEOUT_MS=

# ------------------------------------------------------------
# Operação
# ------------------------------------------------------------
LOG_LEVEL=
APP_MEM_LIMIT=
MYSQL_MEM_LIMIT=
# Segredos via arquivo (Docker/Compose secrets):
# ENCRYPTION_KEY_FILE=/run/secrets/encryption_key
# (suportado para DATABASE_URL, JWT_SECRET e ENCRYPTION_KEY)

# ------------------------------------------------------------
# Jobs agendados (todos ligados por padrão; use "false" para desligar)
# ------------------------------------------------------------
EMAIL_SYNC_ENABLED=true
EMAIL_SYNC_CRON=*/15 * * * *
ALERTS_ENABLED=true
ALERTS_CRON=0 8 * * *
BACKUP_ENABLED=true
BACKUP_CRON=0 3 * * *
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14

# WhatsApp para os alertas diários (opcional).
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_URL=
WHATSAPP_TO=

# ------------------------------------------------------------
# Segurança adicional
# ------------------------------------------------------------
FORCE_SECURE_COOKIES=false
FAILURE_ALERTS_ENABLED=true

# ------------------------------------------------------------
# Dados da empresa nos PDFs de proposta
# ------------------------------------------------------------
COMPANY_NAME=
COMPANY_CNPJ=
COMPANY_ADDRESS=
COMPANY_CITY=
COMPANY_STATE=
COMPANY_ZIP=
COMPANY_PHONE=
COMPANY_EMAIL=

# ------------------------------------------------------------
# Proxy de armazenamento/IA legado (Forge)
# ------------------------------------------------------------
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=