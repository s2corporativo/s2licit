# ============================================================
# Sistema S2 — Variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env.
# ============================================================

# Banco de dados MySQL (obrigatório)
# Ex.: mysql://usuario:senha@localhost:3306/s2licit
DATABASE_URL=

# Segredo para assinar os cookies de sessão (JWT).
# Obrigatório em produção. Gere com: openssl rand -base64 48
JWT_SECRET=

# Chave para criptografar credenciais de fornecedores (scrapers).
# Obrigatório em produção. Gere com: openssl rand -base64 48
ENCRYPTION_KEY=

# Porta do servidor (padrão 3000)
PORT=3000

# ------------------------------------------------------------
# Autenticação
# ------------------------------------------------------------
# Modo padrão: login local (email/senha). Para criar o primeiro
# administrador, defina no primeiro boot:
ADMIN_EMAIL=
ADMIN_PASSWORD=

# (Opcional/legado) OAuth externo — deixe vazio para usar login local
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# ------------------------------------------------------------
# Inteligência artificial (enriquecimento, matching assistido)
# ------------------------------------------------------------
# Provedor de IA preferido: auto | anthropic | groq  (padrão: auto)
AI_PROVIDER=auto
# Chave da API da Anthropic (https://console.anthropic.com) — mais precisa
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Chave da GroqCloud (https://console.groq.com) — rápida, tier gratuito
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Cotação USD→BRL usada só para EXIBIR o custo estimado de IA em reais na
# Central de IA (padrão: 5.5). Ajuste quando quiser um número mais fiel.
USD_BRL_RATE=

# ------------------------------------------------------------
# Integrações externas (opcionais)
# ------------------------------------------------------------
# Ingestão de cotações por e-mail (IMAP)
# Sem estas variáveis, a tela "Cotações Recebidas" funciona, mas a
# sincronização automática fica desabilitada.
# ------------------------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true
IMAP_MAILBOX=INBOX

# ------------------------------------------------------------
# Envio de e-mail (SMTP) — para responder cotações com o PDF anexado.
# Sem estas variáveis, o botão "Responder por e-mail" fica oculto.
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=

# ------------------------------------------------------------
# Captura de catálogo dos fornecedores (scraper)
# ------------------------------------------------------------
# Teto de páginas por categoria na varredura (trava de segurança contra
# paginação infinita; a captura para sozinha no fim real do catálogo).
SCRAPER_MAX_PAGES=1000
# Execução automática dos scrapers no horário configurado por fornecedor
SCRAPER_SCHEDULE_ENABLED=true
# Expressão da verificação de agendamento (padrão: a cada minuto)
SCRAPER_SCHEDULE_CRON="* * * * *"

# ------------------------------------------------------------
# Armazenamento e diversos (opcionais)
# ------------------------------------------------------------
# Diretório de uploads (logos, anexos). Padrão: ./uploads
UPLOAD_DIR=
# URL da página de licitações da FIEMG (conector opcional)
FIEMG_LICITACOES_URL=
# Timeout das chamadas de IA em ms (padrão interno)
LLM_TIMEOUT_MS=

# ------------------------------------------------------------
# Operação
# ------------------------------------------------------------
# Nível mínimo de log estruturado: debug | info | warn | error (padrão: info).
# Em produção cada evento sai como UMA linha JSON (fácil de coletar/filtrar).
LOG_LEVEL=
# Tetos de memória dos containers (docker-compose): protege o MySQL de um
# scrape pesado no app. Padrões: app 2g, MySQL 1g.
APP_MEM_LIMIT=
MYSQL_MEM_LIMIT=
# Segredos via arquivo (Docker/Compose secrets): defina NOME_FILE apontando
# para o arquivo em vez de colocar o valor na env — ex.:
# ENCRYPTION_KEY_FILE=/run/secrets/encryption_key
# (suportado para DATABASE_URL, JWT_SECRET e ENCRYPTION_KEY)

# ------------------------------------------------------------
# Jobs agendados (todos ligados por padrão; use "false" para desligar)
# ------------------------------------------------------------
# Sincronização automática da caixa de cotações (só roda se IMAP configurado)
EMAIL_SYNC_ENABLED=true
EMAIL_SYNC_CRON="*/15 * * * *"
# Pipeline automático cotação→proposta: auto-confirma SOMENTE match por código
# de catálogo exato (CATMAS/CATMAT) com custo positivo. Similaridade de nome é
# apenas sugestão e sempre exige confirmação humana, mesmo com score alto.
QUOTATION_AUTO_PIPELINE_ENABLED=true
# Similaridade mínima para um produto aparecer como sugestão de match por nome.
# Não controla auto-confirmação; padrão interno: 0.68.
QUOTATION_NAME_MATCH_THRESHOLD=0.68
# CUIDADO: "true" envia a proposta por e-mail SEM revisão humana.
QUOTATION_AUTO_SEND_ENABLED=false
# Radar autenticado: usa as credenciais do cofre (tela Portais) para entrar
# na área do fornecedor (Funarbe, Compras MG, FIEMG, Fundep, COPASA, CEMIG)
# quando o mural público não lista as cotações. CAPTCHA nunca é resolvido
# pelo robô. A sessão (cookies) fica salva por algumas horas para evitar
# logar de novo a cada execução do radar.
PORTAL_AUTH_DISCOVERY_ENABLED=true
PORTAL_SESSION_REUSE_TTL_HOURS=6
# Teste de fumaça semanal: só tenta logar (sem coletar nada) em cada portal
# com credencial cadastrada e avisa se algum login parou de funcionar.
PORTAL_LOGIN_SMOKETEST_ENABLED=true
PORTAL_LOGIN_SMOKETEST_CRON="0 6 * * 1"
# Alertas proativos diários (certidões vencendo, prazos de cotação)
ALERTS_ENABLED=true
ALERTS_CRON="0 8 * * *"
# Backup automático do banco (requer mysqldump; a imagem Docker já o inclui)
BACKUP_ENABLED=true
BACKUP_CRON="0 3 * * *"
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14

# WhatsApp para os alertas diários (opcional). Deixe em branco para desligar.
# Opção A — API Cloud da Meta (WhatsApp Business):
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Opção B — webhook próprio (Z-API/Twilio/n8n); recebe POST {to, message}:
WHATSAPP_WEBHOOK_URL=
# Destino(s) em E.164, separados por vírgula (ex.: 5531999998888):
WHATSAPP_TO=

# ------------------------------------------------------------
# Segurança adicional
# ------------------------------------------------------------
# Força o atributo Secure nos cookies de sessão (recomendado com TLS/domínio).
# Não ligue em acesso por IP sem HTTPS — o login deixaria de funcionar.
FORCE_SECURE_COOKIES=false
# Alertas de falha de jobs (captura agendada, backup) por notificação/WhatsApp
FAILURE_ALERTS_ENABLED=true

# ------------------------------------------------------------
# Dados da empresa nos PDFs de proposta (fallback quando não configurados
# pela tela Configurações da Empresa)
# ------------------------------------------------------------
COMPANY_NAME=
COMPANY_CNPJ=
COMPANY_ADDRESS=
COMPANY_CITY=
COMPANY_STATE=
COMPANY_ZIP=
COMPANY_PHONE=
COMPANY_EMAIL=

# ------------------------------------------------------------
# Proxy de armazenamento/IA legado (Forge) — deixe em branco em VPS;
# quando ausentes, uploads vão para o disco local (UPLOAD_DIR)
# ------------------------------------------------------------
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=