[Unit]
Description=S2 Licit smoke autenticado de produção
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/s2licit
ExecStart=/opt/s2licit/scripts/production-smoke-host.sh
TimeoutStartSec=25min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
